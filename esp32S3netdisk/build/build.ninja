build gen_esp32p4c6netdisk_binary: phony CMakeFiles/gen_esp32p4c6netdisk_binary .bin_timestamp esp32p4c6netdisk.elf


#############################################
# Utility command for gen_project_binary

build gen_project_binary: phony CMakeFiles/gen_project_binary gen_esp32p4c6netdisk_binary


#############################################
# Utility command for app

build app: phony CMakeFiles/app app_check_size gen_project_binary


#############################################
