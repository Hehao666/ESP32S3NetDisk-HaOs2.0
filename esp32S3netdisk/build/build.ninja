build CMakeFiles/encrypted-app-flash | ${cmake_ninja_workdir}CMakeFiles/encrypted-app-flash: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32_project\ESP32S3\esp32S3netdisk_3_1.7\esp32S3netdisk\build && D:\ESP-IDF\tool\tools\cmake\4.0.3\bin\cmake.exe -E echo "Error: The target encrypted-app-flash requires" && D:\ESP-IDF\tool\tools\cmake\4.0.3\bin\cmake.exe -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && D:\ESP-IDF\tool\tools\cmake\4.0.3\bin\cmake.exe -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" D:/ESP-IDF/tool/tools/cmake/4.0.3/bin/cmake.exe -P D:/ESP-IDF/espidf/v6.0/esp-idf/tools/cmake/scripts/fail.cmake"


